[Unit]
Description=Stock Analyzer Web App - Flask/SocketIO UI
After=network.target auto-trading.service

[Service]
Type=simple
WorkingDirectory=/home/saengtawan/work/project/cc/stock-analyzer
Environment="PATH=/home/saengtawan/.pyenv/versions/cc/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
EnvironmentFile=/home/saengtawan/work/project/cc/stock-analyzer/.env

ExecStart=/home/saengtawan/.pyenv/versions/cc/bin/python src/web/app.py

# Restart on crash/OOM — but NOT when stopped via systemctl stop
Restart=on-failure
RestartSec=10s

# Logging to dedicated file (same pattern as engine)
StandardOutput=append:/home/saengtawan/work/project/cc/stock-analyzer/logs/web_app.log
StandardError=append:/home/saengtawan/work/project/cc/stock-analyzer/logs/web_app.log

[Install]
WantedBy=default.target
